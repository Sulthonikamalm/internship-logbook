# ==============================================================================
# InternFlow Environment Configuration
# ==============================================================================
# Copy this file to .env.local for local development:
# cp .env.example .env.local

# ------------------------------------------------------------------------------
# 1. Supabase (Database & Authentication)
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# SUPABASE_SERVICE_ROLE_KEY is strictly server-side ONLY.
# NEVER prefix with NEXT_PUBLIC_ or expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Application Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_BASE_URL=http://localhost:3000
APP_ENV=development

# ------------------------------------------------------------------------------
# 3. Google Drive API (Centralized Photo Evidence Storage)
# ------------------------------------------------------------------------------
# Server-side only. Used for storing internship photo evidence in centralized Google Drive.
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret
GOOGLE_REFRESH_TOKEN=1//your-google-refresh-token
GOOGLE_DRIVE_ROOT_FOLDER_ID=your-google-drive-root-folder-id
EVIDENCE_RECONCILE_SECRET=replace-with-a-random-value-of-at-least-32-characters
