# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*.local
.env
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local Codex credentials, screenshots, checkpoints, and exported reports
/.codex/local/
/.codex/logbook.local.json

# Public MCP artifacts are rebuilt from an explicit allowlist before dev/build.
/public/downloads/internflow-mcp.zip
/public/downloads/internflow-mcp.sha256
/public/downloads/internflow-mcp.json
